# ===========================================================================
# OBLIGATORIO — sin esto la aplicación no responde
# ===========================================================================

# Clave de https://openrouter.ai/ para el modelo que genera las respuestas.
OPENROUTER_API_KEY=


# ===========================================================================
# RECOMENDADO — el grafo de conocimiento
# ===========================================================================
# Sin Neo4j la aplicación funciona igual: responde con búsqueda vectorial y
# léxica sobre los documentos. Solo se pierden las preguntas que necesitan
# recorrer relaciones ("¿quién gestiona el contrato que firmó X?").
#
# La capa gratuita de Neo4j Aura basta: https://neo4j.com/cloud/aura/

NEO4J_URI=neo4j+s://tu-instancia.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=


# ===========================================================================
# IDENTIDAD — cómo se llama tu instalación
# ===========================================================================

COMPANY_NAME="Enterprise Knowledge"


# ===========================================================================
# PRODUCCIÓN — obligatorias solo si ENVIRONMENT=production
# ===========================================================================
# En producción el arranque falla si falta cualquiera de estas, a propósito.
# En desarrollo se generan solas en cada arranque.

ENVIRONMENT=development

# Firma los tokens de sesión. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Protege /webhook/ingest, la entrada para automatizaciones (Make, n8n, CRM).
WEBHOOK_API_KEY=

# Dominios autorizados a llamar a la API desde un navegador.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# ===========================================================================
# OPCIONAL — todo esto tiene valores por defecto razonables
# ===========================================================================

# Modelo generador. Cualquiera de los que sirve OpenRouter.
# PRIMARY_MODEL=openrouter/openai/gpt-4o-mini

# Exigir token JWT en todas las rutas. Siempre activo si ENVIRONMENT=production.
# AUTH_REQUIRED=false

# Tamaño del modelo de transcripción de voz (tiny, base, small, medium).
# WHISPER_MODEL_SIZE=base

# Dónde se guardan los vectores.
# CHROMADB_PERSIST_DIR=./chroma_db

# Varias organizaciones en la misma instalación: ver tenants.example.json
# DEFAULT_TENANT_ID=default

# Trazas del agente en LangSmith, si quieres depurar el flujo paso a paso.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=enterprise-knowledge
