# ===========================================================================
# Enterprise Hybrid GraphRAG — Variables de Entorno
# ===========================================================================
# COPIAR ESTE ARCHIVO A '.env' Y CONFIGURAR LOS VALORES REALES.
# NUNCA versionar el archivo '.env' con credenciales reales.
# ===========================================================================

# Entorno de ejecución: development | staging | production
# En 'production' y 'staging', se aplican validaciones de seguridad estrictas:
#   - JWT_SECRET_KEY y WEBHOOK_API_KEY son obligatorios (sin defaults)
#   - AUTH_REQUIRED se fuerza a true
#   - Guardrails operan en modo fail-closed
ENVIRONMENT=development

# ===========================================================================
# SEGURIDAD Y AUTENTICACIÓN
# ===========================================================================

# Secreto JWT para firma de tokens. OBLIGATORIO en producción.
# Generar un valor seguro con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Algoritmo JWT (HS256 por defecto, RS256 recomendado para multi-servicio)
JWT_ALGORITHM=HS256

# Duración del token JWT en minutos (1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Autenticación obligatoria (solo JWT). Siempre activa en production/staging.
# En development es opcional: sin ella, la UI local funciona como usuario admin.
AUTH_REQUIRED=

# API Key para Webhooks de ingesta (n8n, Make, CRM). OBLIGATORIO en producción.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_API_KEY=

# ===========================================================================
# LangSmith (Observabilidad y Trazas)
# ===========================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=graphrag-enterprise

# ===========================================================================
# Neo4j (Base de Datos de Grafos)
# ===========================================================================
# Usar neo4j+s:// para conexión con TLS (obligatorio en producción)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=

# ===========================================================================
# OpenRouter / LLM Provider
# ===========================================================================
OPENROUTER_API_KEY=

# Modelo LLM principal (OpenRouter path)
PRIMARY_MODEL=openrouter/openai/gpt-4o-mini

# ===========================================================================
# Whisper (Transcripción de Voz Local)
# ===========================================================================
# Tamaño del modelo: tiny | base | small | medium | large
WHISPER_MODEL_SIZE=base

# ===========================================================================
# Re-ranking
# ===========================================================================
# Motor de re-ranking: local (ONNX/FlashRank), llm, auto
RERANKER_ENGINE=local
RERANKING_ENABLED=true
LOCAL_RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# ===========================================================================
# ChromaDB
# ===========================================================================
CHROMADB_PERSIST_DIR=./chroma_db

# ===========================================================================
# Configuración White-Label
# El nombre de TU organización: aparece en la barra lateral, la pestaña,
# la insignia del asistente y el pie de las respuestas.
# ===========================================================================
COMPANY_NAME="Enterprise Knowledge"
APP_SUBTITLE="Plataforma de Inteligencia Corporativa con GraphRAG"

# ===========================================================================
# Organizaciones (multi-inquilino)
# ===========================================================================
# Cada organización tiene su propio corpus, grafo y caché, aislados entre sí.
# El tenant_id viaja firmado dentro del JWT.
#
# Despliegue para UNA sola organización (lo habitual): no toques nada. Todo
# usa DEFAULT_TENANT_ID y el nombre sale de COMPANY_NAME.
DEFAULT_TENANT_ID=default
#
# Para VARIAS organizaciones en la misma instalación, crea 'tenants.json'
# en la raíz (ver tenants.example.json) y emite un token por organización:
#   POST /api/auth/token  {"user_id": "ana", "role": "admin", "tenant_id": "acme"}
# TENANTS_FILE=./tenants.json

# ===========================================================================
# CORS (orígenes permitidos, separados por coma)
# ===========================================================================
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000
